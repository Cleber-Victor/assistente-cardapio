# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Opcional: "hashing" usa busca leve sem baixar modelo (bom para testar rápido)
# EMBEDDER=hashing
